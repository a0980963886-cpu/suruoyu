# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT / Auth Token 簽發金鑰（必填高強度金鑰，缺少時系統依安全原則 Fail-Closed 拒絕啟動）
AUTH_SECRET_KEY="請設定高強度隨機金鑰字串"
JWT_SECRET="請設定高強度隨機金鑰字串"

# 第一個管理員安全初始化設定（雙重控制權驗證：Email + 一次性初始化秘密）
# 1. INITIAL_ADMIN_EMAIL：指定第一個管理員的信箱
# 2. ADMIN_BOOTSTRAP_SECRET：一次性初始化秘密（部署者持有，用於首次建立 Admin，成功後 Firestore 永久標記失效）
INITIAL_ADMIN_EMAIL="myadmin@domain.com"
ADMIN_BOOTSTRAP_SECRET="請設定部署者持有之一次性初始化秘密"

# Firebase Firestore 雲端資料庫配置（正式部署時使用）
FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_SERVICE_ACCOUNT_KEY：若部署於 Google Cloud Run 且使用預設服務帳號，可留空；
# 若使用獨立服務帳號 JSON，請將完整的 JSON 字串貼於此（勿包含換行）。
FIREBASE_SERVICE_ACCOUNT_KEY=""

